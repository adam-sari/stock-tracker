# Alpaca — paper trading account
# Get from https://alpaca.markets → Dashboard → Paper Trading → View
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Finnhub — free tier
# Get from https://finnhub.io
FINNHUB_API_KEY=

# Financial Modeling Prep — free tier
# Get from https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# SEC EDGAR contact email — required by EDGAR fair-access policy.
# Used as the User-Agent identifier when the Python sidecar fetches filings.
# Use any real, reachable email address you own.
EDGAR_CONTACT_EMAIL=

# OpenFIGI API key — optional. Increases CUSIP→ticker resolution batch size.
# Get from https://www.openfigi.com/api
OPENFIGI_API_KEY=

# Anthropic API key — required for the AI research assistant
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Cost controls for the research assistant
# Per-call ceiling (USD). Generation truncates and stores as 'partial' if exceeded.
RESEARCH_STANDARD_CEILING_USD=0.08
RESEARCH_DEEP_CEILING_USD=0.25
# Monthly budget across all research generations (USD). POST returns 402 when exceeded.
RESEARCH_MONTHLY_BUDGET_USD=50

# Model ID for research generation (default: claude-opus-4-7)
RESEARCH_MODEL_ID=claude-opus-4-7
